<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CarThing.Connector</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Carthing Connector</ApplicationTitle>
    <ApplicationId>io.github.carthingconnector.android</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- Avoid missing MauiApplication JNI entry points in Release builds.
         https://github.com/dotnet/maui/issues/35209 -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../carthing-core/CarThing.Core.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#19242E" />
    <MauiSplashScreen Include="Resources/AppIcon/appicon.svg" Color="#19242E" BaseSize="128,128" />
  </ItemGroup>
</Project>
